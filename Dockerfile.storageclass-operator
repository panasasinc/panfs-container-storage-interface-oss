# Image of panfs-storageclass-operator: the program that creates a StorageClass for every PanfsStorageClass resource.

# Set the Go version to use (default: 1.27)
ARG GOLANG_VERSION=1.27

# MARK: Stage 1: Download Go modules for caching
FROM golang:${GOLANG_VERSION} AS modules

COPY go.mod go.sum /modules/
WORKDIR /modules
RUN go mod download

# MARK: Stage 2: Build the Go binary
FROM golang:${GOLANG_VERSION} AS builder
ARG APP_VERSION="dev"

COPY --from=modules /go/pkg /go/pkg

WORKDIR /app

COPY pkg/ pkg/
COPY cmd/ cmd/
COPY go.mod go.sum ./

# Build the binary for Linux amd64, statically linked
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -ldflags "-X main.version=${APP_VERSION}" \
    -o /bin/panfs-storageclass-operator ./cmd/storageclass-operator

# MARK: Stage 3: Create the final image
FROM alpine:3.24 AS storageclass-operator

ARG BUILD_DATE
ARG VERSION
ARG GIT_COMMIT

# OCI labels for Open Container Initiative compliance
LABEL org.opencontainers.image.title="PanFS StorageClass Operator" \
      org.opencontainers.image.description="Creates a StorageClass of the PanFS CSI driver for every PanfsStorageClass resource" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.revision="${GIT_COMMIT}" \
      org.opencontainers.image.vendor="PanFS CSI Team"

# The operator only talks to the Kubernetes API: it needs no tools from the image.
RUN apk update && apk upgrade && rm -rf /var/cache/apk/*

COPY --from=builder /bin/panfs-storageclass-operator /panfs-storageclass-operator

ENTRYPOINT ["/panfs-storageclass-operator"]
